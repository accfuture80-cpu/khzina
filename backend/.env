DATABASE_URL=postgresql://postgres:123456@localhost:5432/khazina_db

# إعدادات السيرفر
PORT=3000
NODE_ENV=development

# إعدادات قاعدة البيانات
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=123456
DB_DATABASE=khazina_db

# تشغيل/إيقاف تسجيل استعلامات SQL في الـ Terminal
DB_LOGGING=false


# إعدادات JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# مسار حفظ المرفقات
UPLOADS_PATH=./uploads